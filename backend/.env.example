# Copy to .env and fill in. NEVER commit .env.

# bcrypt hash of your admin password — generate with:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Random secret used to sign login tokens — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login stays valid (minutes)
JWT_TTL_MINUTES=120

# Comma-separated list of sites allowed to call this API (your portfolio origin).
# Use the exact scheme+host, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Postgres connection string (Vercel Postgres exposes POSTGRES_URL; Neon/others
# expose DATABASE_URL — either is read automatically).
DATABASE_URL=

# Optional: get a Telegram push on each new message. Leave blank to disable.
#   1. In Telegram, message @BotFather → /newbot → copy the token below
#   2. Message your new bot once, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
