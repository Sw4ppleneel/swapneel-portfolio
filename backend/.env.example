# Copy to .env and fill in. NEVER commit .env.

# bcrypt hash of your admin password — generate with:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Random secret used to sign login tokens — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login stays valid (minutes)
JWT_TTL_MINUTES=120

# Comma-separated list of sites allowed to call this API (your portfolio origin).
# Use the exact scheme+host, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Where the SQLite inbox lives
DB_PATH=./inbox.db
